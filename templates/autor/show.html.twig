{% extends 'base.html.twig' %}

{% block title %}
    Autor
{% endblock %}

{% block body %}
    <h1>
        Autor
    </h1>

    <table class="table table-striped table-hover mt-3">
        <tbody>
            <tr>
                <th>
                    Id
                </th>
                <td>
                    {{ autor.id }}
                </td>
            </tr>
            <tr>
                <th>
                    Nome
                </th>
                <td>
                    {{ autor.nome }}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_autor_index') }}">back to list</a>

    <a href="{{
        path(
            'app_autor_edit',
            {
                id: autor.id
            }
        )
        }}">
        edit
    </a>

    {{ include('autor/_delete_form.html.twig') }}
{% endblock %}
