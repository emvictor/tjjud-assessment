{% extends 'base.html.twig' %}

{% block title %}
    Autor:
    {{ autor.nome }}
{% endblock %}

{% block body %}
    <div class="container mt-4 pb-5">
        <div class="mb-4">
            <a href="{{ path('app_autor_index') }}" class="btn btn-link link-secondary p-0 text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Voltar para a lista de autores
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7">

                {% set card_body %}
                <div class="mb-4">
                    <label class="text-uppercase tiny fw-bold text-muted d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        Nome do Autor
                    </label>
                    <h2 class="fw-bold text-dark">
                        {{ autor.nome }}
                    </h2>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">
                            Obras no Acervo
                        </h5>
                        <span class="badge bg-light text-primary border fw-medium">
                            {{ autor.livros|length }}
                            Livros
                        </span>
                    </div>

                    <div class="list-group list-group-flush mx-n4">
                        {% for livro in autor.livros %}
                            <a href="{{ path('app_livro_show', {id: livro.id}) }}" class="list-group-item list-group-item-action border-0 px-4 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-book me-2 text-muted"></i>
                                    <span class="fw-medium">
                                        {{ livro.titulo }}
                                    </span>
                                </div>
                                <span class="text-muted small">
                                    {{ livro.anoPublicacao }}
                                </span>
                            </a>
                        {% else %}
                            <div class="px-4 py-4 text-center bg-light rounded-3 mx-4">
                                <p class="text-muted small mb-0">
                                    Nenhuma obra vinculada a este autor.
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endset %}

                {% set card_footer %}
                <div class="d-flex justify-content-between align-items-center w-100">
                    <a href="{{ path('app_autor_edit', {id: autor.id}) }}" class="btn btn-primary px-4">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar
                    </a>

                    <div class="action-delete">
                        {{ include('autor/_delete_form.html.twig') }}
                    </div>
                </div>
                {% endset %}

                {{ include('components/_action_card.html.twig', {
                'title': 'Informações do Autor',
                'icon': 'person-vcard',
                'variant': 'dark',
                'body': card_body,
                'footer': card_footer
            }) }}

            </div>
        </div>
    </div>
{% endblock %}
