<form method="post" action="{{ path('app_autor_delete', {'id': autor.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ autor.id) }}">

        <twig:delete_button title="Excluir Autor" message="Deseja realmente excluir o autor <strong>{{ autor.nome }}</strong>?" class="btn border-0"></twig:delete_button>
    </form>
    