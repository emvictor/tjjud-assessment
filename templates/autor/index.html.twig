{% extends 'base.html.twig' %}

{% block title %}
    Autores
{% endblock %}

{% block body %}
    <div class="container mt-4 pb-5">
        {% set autor_list %}
        <div class="list-group list-group-flush mx-n4">
            {% for autor in autors %}
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                    <div>
                        <h6 class="mb-0 fw-bold">
                            {{ autor.nome }}
                        </h6>
                        <small class="text-muted">
                            <i class="bi bi-book"></i>
                            {{ autor.livros|length }}
                            Livros no catálogo
                        </small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <a href="{{ path('app_autor_show', {id: autor.id}) }}" class="btn btn-outline-secondary">
                            Ver
                        </a>
                        <a href="{{ path('app_autor_edit', {id: autor.id}) }}" class="btn btn-outline-primary">
                            Editar
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-people h1 d-block mb-3 opacity-25"></i>
                    Nenhum autor cadastrado.
                </div>
            {% endfor %}
        </div>
        {% endset %}

        <div class="row justify-content-center">
            <div class="col-lg-10">
                {{ include('components/_action_card.html.twig', {
                    'title': 'Gerenciamento de Autores',
                    'icon': 'people-fill',
                    'variant': 'dark',
                    'body': autor_list,
                    'new_path': path('app_autor_new'),
                    'new_label': 'Novo Autor'
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
