{% extends 'base.html.twig' %}

{% block title %}
    Autor index
{% endblock %}

{% block body %}
    <h1>
        Autor index
    </h1>

    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Nome
                </th>
                <th>
                    actions
                </th>
            </tr>
        </thead>
        <tbody>
            {% for autor in autors %}
                <tr>
                    <td>
                        {{ autor.id }}
                    </td>
                    <td>
                        {{ autor.nome }}
                    </td>
                    <td>
                        <a href="{{
                            path(
                                'app_autor_show',
                                {
                                    id: autor.id
                                }
                            )
                            }}">
                            show
                        </a>
                        <a href="{{
                            path(
                                'app_autor_edit',
                                {
                                    id: autor.id
                                }
                            )
                            }}">
                            edit
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">
                        no records found
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_autor_new') }}">Create new</a>
{% endblock %}
