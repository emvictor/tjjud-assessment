{% extends 'base.html.twig' %}

{% block title %}
    Relatório de Livros por Autor
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            Relatório Geral (Agrupado por Autor)
        </h2>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            🖨️ Imprimir Relatório
        </button>
    </div>

    {# O array 'relatorio' vem do Controller. A chave é o nome do autor, o valor é a lista de livros dele #}
    {% for autor, livros in relatorio %}
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    Autor(a): {{ autor }}
                </h4>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                Título do Livro
                            </th>
                            <th>
                                Editora
                            </th>
                            <th>
                                Edição
                            </th>
                            <th>
                                Ano
                            </th>
                            <th>
                                Assuntos
                            </th>
                            <th>
                                Valor (R$)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for livro in livros %}
                            <tr>
                                <td>
                                    <strong>{{ livro.livro_titulo }}</strong>
                                </td>
                                <td>
                                    {{ livro.livro_editora }}
                                </td>
                                <td>
                                    {{ livro.livro_edicao }}ª
                                </td>
                                <td>
                                    {{ livro.livro_ano }}
                                </td>
                                <td>
                                    <em>
                                        {{
                                            livro.assuntos|default(
                                                'Nenhum assunto'
                                            )
                                        }}
                                    </em>
                                </td>
                                {# Formatação obrigatória exigida no teste #}
                                <td class="text-success fw-bold">
                                    R$ {{ livro.livro_valor|number_format(2, ',', '.') }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            Nenhum dado encontrado para gerar o relatório. Crie alguns livros e
            autores primeiro!
        </div>
    {% endfor %}
{% endblock %}
