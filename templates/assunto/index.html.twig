{% extends 'base.html.twig' %}

{% block title %}
    Assuntos
{% endblock %}

{% block body %}
    <div class="container mt-4 pb-5">

        {% set assunto_list %}
        <div class="list-group list-group-flush mx-n4">
            {% for assunto in assuntos %}
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                    <div>
                        <h6 class="mb-0 fw-bold">
                            {{ assunto.descricao }}
                        </h6>
                        <small class="text-muted">
                            <i class="bi bi-book"></i>
                            {{ assunto.livros|length }}
                            Livros vinculados
                        </small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <a href="{{ path('app_assunto_show', {id: assunto.id}) }}" class="btn btn-outline-secondary">
                            Ver
                        </a>
                        <a href="{{ path('app_assunto_edit', {id: assunto.id}) }}" class="btn btn-outline-primary">
                            Editar
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-tags h1 d-block mb-3 opacity-25"></i>
                    Nenhum assunto cadastrado no acervo.
                </div>
            {% endfor %}
        </div>
        {% endset %}

        <div class="row justify-content-center">
            <div class="col-lg-10">
                {{ include('components/_action_card.html.twig', {
                    'title': 'Gerenciamento de Assuntos',
                    'icon': 'tags-fill',
                    'variant': 'primary',
                    'body': assunto_list,
                    'new_path': path('app_assunto_new'),
                    'new_label': 'Novo Assunto'
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
