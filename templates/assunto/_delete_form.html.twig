<form method="post" action="{{ path('app_assunto_delete', {'id': assunto.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assunto.id) }}">

        <twig:delete_button title="Excluir Assunto" message="Deseja realmente excluir o assunto <strong>{{ assunto.descricao }}</strong>?" class="btn border-0"></twig:delete_button>
    </form>
    