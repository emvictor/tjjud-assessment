{% extends 'base.html.twig' %}

{% block title %}
    Livros
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <action-card title="Livros" variant="primary">

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>
                                Id
                            </th>
                            <th>
                                Titulo
                            </th>
                            <th>
                                Autores
                            </th>
                            <th>
                                Editora
                            </th>
                            <th>
                                Edicao
                            </th>
                            <th>
                                Ano
                            </th>
                            <th>
                                Valor
                            </th>
                            <th class="text-end">
                                Ações
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for livro in livros %}
                            <tr>
                                <td>
                                    {{ livro.id }}
                                </td>
                                <td>
                                    {{ livro.titulo }}
                                </td>
                                <td>
                                    {{ livro.autores|join(', ') }}
                                </td>
                                <td>
                                    {{ livro.editora }}
                                </td>
                                <td>
                                    {{ livro.edicao }}
                                </td>
                                <td>
                                    {{ livro.anoPublicacao }}
                                </td>
                                <td>
                                    R$
                                    {{ livro.valor|number_format(2, ',', '.') }}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('app_livro_show', {id: livro.id}) }}" class="btn btn-outline-secondary">
                                            Ver
                                        </a>
                                        <a href="{{ path('app_livro_edit', {id: livro.id}) }}" class="btn btn-outline-primary">
                                            Editar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    Sem Livros!
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3 pt-3 border-top">
                <a href="{{ path('app_livro_new') }}" class="btn btn-success">
                    <i class="bi bi-plus-lg"></i>
                    Novo Livro
                </a>
            </div>

        </action-card>
    </div>
{% endblock %}
