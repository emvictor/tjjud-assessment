{% extends 'base.html.twig' %}

{% block title %}
    Livros
{% endblock %}

{% block body %}
    <div class="container mt-4">

        {% set book_grid %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            {% for livro in livros %}
                <div class="col">
                    {{ include('components/_livro_card.html.twig', { 'livro': livro }) }}
                </div>
            {% else %}
                <div class="col-12">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-book h1 d-block mb-3 opacity-25"></i>
                        <p>
                            Nenhum título encontrado no acervo no momento.
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% endset %}

        <div class="row justify-content-center">
            <div class="col-12">
                {{ include('components/_action_card.html.twig', {
                    'title': 'Catálogo de Livros',
                    'icon': 'journal-bookmark-fill',
                    'variant': 'primary',
                    'body': book_grid,
                    'new_path': path('app_livro_new'),
                    'new_label': 'Novo Livro'
                }) }}
            </div>
        </div>
    </div>

    <style>
        .card-livro {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .card-livro:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        }
    </style>
{% endblock %}
