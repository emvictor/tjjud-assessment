{% extends 'base.html.twig' %}

{% block title %}
    Editar Livro
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <action-card title="Editar Livro" variant="primary">

                    {# Passing the button_label variable to the sub-form #}
                    {{ include('livro/_form.html.twig', {'button_label': 'Salvar Alterações'}) }}

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_livro_index') }}" class="btn btn-link text-secondary p-0">
                            <i class="bi bi-arrow-left"></i>
                            Voltar para a lista
                        </a>
                    </div>
                </action-card>

                <div class="mt-4">
                    <div class="card border-danger bg-light-subtle">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-danger mb-0 fw-bold">
                                    Atenção:
                                </h6>
                                <small class="text-muted">
                                    A exclusão deste item é permanente.
                                </small>
                            </div>
                            {{ include('livro/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
