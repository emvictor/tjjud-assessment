{% extends 'base.html.twig' %}

{% block title %}
    Editar Livro:
    {{ livro.titulo }}
{% endblock %}

{% block body %}
    <div class="container mt-4 pb-5">
        <div class="mb-4">
            <a href="{{ path('app_livro_index') }}" class="btn btn-link link-secondary p-0 text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Voltar para o catálogo
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                {% set card_body %}
                <div class="py-2">
                    {{ include('livro/_form.html.twig') }}
                </div>

                <div class="mt-4 pt-4 border-top">
                    <div class="d-flex align-items-start text-muted small">
                        <i class="bi bi-shield-lock me-2 mt-1"></i>
                        <div>
                            <span class="d-block fw-bold text-dark">
                                Dica de Integridade
                            </span>
                            As alterações refletirão imediatamente em todos os relatórios e consultas do sistema.
                        </div>
                    </div>
                </div>
                {% endset %}

                {{ include('components/_action_card.html.twig', {
                'title': 'Editar Livro',
                'icon': 'journal-text',
                'variant': 'primary',
                'body': card_body,
                
                'variant_type': 'edit',
                'form_id': 'form-livro',
                'cancel_path': path('app_livro_show', {id: livro.id}),
                'delete_form': 'livro/_delete_form.html.twig'
            }) }}

            </div>
        </div>
    </div>
{% endblock %}
