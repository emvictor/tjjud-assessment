<form method="post" action="{{ path('app_livro_delete', {'id': livro.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ livro.id) }}">

        <twig:delete_button title="Excluir Livro" message="Deseja realmente excluir o livro <strong>{{ livro.titulo }}</strong>?" class="btn border-0"></twig:delete_button>
    </form>
    