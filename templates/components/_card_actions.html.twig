<div class="d-flex justify-content-between align-items-center w-100">

    <div>
        {% if variant == 'edit' or variant == 'new' %}
            <button type="submit" form="{{ formId }}" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-check-lg me-2"></i>
                {{ submitLabel|default(variant == 'edit' ? 'Salvar Alterações' : 'Cadastrar') }}
            </button>
        {% elseif variant == 'show' %}
            <a href="{{ editPath }}" class="btn btn-primary px-4">
                <i class="bi bi-pencil-square me-2"></i>
                Editar
            </a>
        {% endif %}
    </div>

    <div class="d-flex gap-2 align-items-center">
        {% if cancelPath is defined and cancelPath %}
            <a href="{{ cancelPath }}" class="btn btn-light border px-4">
                Cancelar
            </a>
        {% endif %}

        {% if deleteForm is defined and deleteForm %}
            <div class="ms-1">
                {{ include(deleteForm) }}
            </div>
        {% endif %}
    </div>
</div>
